# Configure these in your PHP host dashboard; PHP does not auto-load this file.
APP_ENV=production
APP_SECURE_COOKIES=1
DB_HOST=REPLACE_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_DATABASE
DB_USERNAME=REPLACE_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_SECRET
# Optional: absolute server path to the CA certificate from your DB provider.
DB_SSL_CA=
# Random token (32+ chars), enabled only until the first admin is created.
ADMIN_SETUP_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Optional: private, writable directory OUTSIDE the web root for login rate limits.
PRIVATE_STORAGE_PATH=
# Same random 64-hex secret in Vercel and PHP hosting. Enable after testing the origin.
ORIGIN_SECRET=
