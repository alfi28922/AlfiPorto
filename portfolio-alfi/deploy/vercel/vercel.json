{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node assert-config.mjs",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(?:includes|database|frontend|tools|deploy)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "https://GANTI-DOMAIN-BACKEND.invalid/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-origin-secret"
          },
          "args": "$ORIGIN_SECRET",
          "env": [
            "ORIGIN_SECRET"
          ]
        }
      ]
    }
  ]
}
