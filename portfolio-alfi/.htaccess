DirectoryIndex index.php
Options -Indexes
<FilesMatch "(?i)^(config\.php|Dockerfile|dockerfile\.php|\.env.*|.*\.(sql|md|log|bak|zip|rar))$">
 Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule ^(?:includes|database|frontend|tools|deploy)(?:/|$) - [F,L]
 RewriteRule (^|/)\. - [F,L]
</IfModule>
